# Never bake secrets or local state into the image: .env holds real tokens, and tenants/ +
# runs/ are live persistent state that belongs on a volume, not in an image layer.
mcp-server/.env
tenants/
runs/

# Local tooling, caches, and artifacts the server never reads at runtime.
.git/
.gitignore
.claude/
.DS_Store
**/.DS_Store
**/__pycache__/
**/*.pyc
mcp-server/.venv/
.venv/
docs/
tests/
CHANGELOG.md
mcp-server/com.opsgate.mcpserver.plist

# Docker's own files are not needed inside the image.
Dockerfile
docker-compose.yml
.dockerignore

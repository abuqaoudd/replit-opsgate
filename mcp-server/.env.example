# Copy this file to .env (same folder) and fill in real values. .env is gitignored - it
# never gets committed. This file (.env.example) has no real secrets and is safe to commit.

# Shared token every request to opsgate_mcp_server.py must send as the header
# "X-Opsgate-Token: <token>" (a custom header, not Authorization - Cloudflare's
# free quick tunnels reject requests carrying an Authorization header at the
# edge). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPSGATE_MCP_TOKEN=

# Optional - override the default bind host/port (127.0.0.1:8765).
# OPSGATE_MCP_HOST=127.0.0.1
# OPSGATE_MCP_PORT=8765

# Optional - extra Host header value(s) this server accepts, needed whenever it's reached
# through a tunnel/reverse-proxy domain (the mcp SDK's DNS-rebinding protection otherwise
# rejects any Host header other than 127.0.0.1/localhost/[::1] with a 421). Comma-separated.
# OPSGATE_MCP_ALLOWED_HOSTS=your-tunnel-hostname.example

# Minimal OAuth 2.1 + PKCE wrapper (opsgate_oauth.py) for Claude's org-level "custom
# connector" flow, which is OAuth-only - there is no static-header option there. Generate
# client_id/secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"   # client id
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"   # client secret
# Paste both into Claude's connector-setup form. OPSGATE_OAUTH_BACKING_TOKEN is the
# existing X-Opsgate-Token value a successful OAuth exchange hands back as the access_token -
# reuse a real tenant token here, don't invent a new kind of credential.
# OPSGATE_OAUTH_CLIENT_ID=
# OPSGATE_OAUTH_CLIENT_SECRET=
# OPSGATE_OAUTH_BACKING_TOKEN=

# Optional but recommended - restricts /authorize to one known redirect_uri, closing an
# open-redirect surface that's otherwise left open (see opsgate_oauth.py's module docstring).
# For Claude's own org-level connector flow, the confirmed real value is:
# OPSGATE_OAUTH_ALLOWED_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback

# Optional - overrides the externally-reachable base URL OAuth metadata advertises.
# Defaults to OPSGATE_MCP_ALLOWED_HOSTS's tunnel hostname's https URL if unset - only needed
# if that default doesn't match how this server is actually reached.
# OPSGATE_OAUTH_ISSUER_BASE_URL=
